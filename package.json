{
    "name": "solas-attendance-tracker",
    "version": "0.0.3",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "update-types": "npx supabase gen types typescript --project-id \"$PROJECT_ID\" > src/lib/types/supabase.ts",
        "prepare": "npm run smui-theme-light && npm run smui-theme-dark",
        "smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
        "smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
        "preview": "vite preview",
        "test": "playwright test",
        "test:e2e": "playwright test",
        "test:unit": "vitest run --config vitest.config.js",
        "test:unit:watch": "vitest --config vitest.config.js",
        "test:all": "npm run test:unit && npm run test:e2e",
        "seed:dev": "node scripts/seed-solas-dev.mjs",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@carbon/charts": "^1.22.18",
        "@carbon/charts-svelte": "^1.22.18",
        "@eslint/js": "^9.19.0",
        "@playwright/test": "^1.55.0",
        "@smui-extra/autocomplete": "^9.0.2",
        "@smui/button": "^9.0.2",
        "@smui/card": "^9.0.2",
        "@smui/checkbox": "^9.0.2",
        "@smui/common": "^9.0.2",
        "@smui/data-table": "^9.0.2",
        "@smui/dialog": "^9.0.2",
        "@smui/form-field": "^9.0.2",
        "@smui/icon-button": "^9.0.2",
        "@smui/layout-grid": "^9.0.2",
        "@smui/list": "^9.0.2",
        "@smui/select": "^9.0.2",
        "@smui/snackbar": "^9.0.2",
        "@smui/tab": "^9.0.2",
        "@smui/tab-bar": "^9.0.2",
        "@smui/textfield": "^9.0.2",
        "@smui/top-app-bar": "^9.0.2",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.112.3",
        "@sveltejs/adapter-auto": "8.0.0-next.3",
        "@sveltejs/adapter-vercel": "7.0.0-next.8",
        "@sveltejs/kit": "3.0.0-next.25",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tsconfig/svelte": "^5.0.4",
        "@types/luxon": "^3.4.2",
        "@types/node": "^26.2.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.19.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-svelte": "^2.46.1",
        "globals": "^15.14.0",
        "luxon": "^3.5.0",
        "postcss": "^8.5.1",
        "postcss-load-config": "^6.0.1",
        "postcss-preset-env": "^10.1.3",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.4.2",
        "prettier-plugin-svelte": "^3.3.3",
        "smui-theme": "^9.0.2",
        "svelte": "^5.56.4",
        "svelte-check": "^4.7.5",
        "svelte-preprocess": "^6.0.3",
        "tslib": "^2.8.1",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.21.0",
        "vite": "^8.0.12",
        "vitest": "^3.2.4",
        "yup": "^1.6.1"
    },
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "engines": {
        "node": ">=22.17.0"
    }
}
