{
    "name": "solas-attendance-tracker",
    "version": "0.0.3",
    "private": true,
    "scripts": {
        "dev": "node scripts/run-dev-local.mjs",
        "dev:vite": "vite dev",
        "build": "vite build",
        "update-types": "npx supabase gen types typescript --project-id \"$PROJECT_ID\" > src/lib/types/supabase.ts",
        "prepare": "husky && npm run smui-theme-light && npm run smui-theme-dark",
        "smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
        "smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
        "preview": "vite preview",
        "test": "npm run test:e2e",
        "test:e2e": "node scripts/run-e2e-local.mjs",
        "test:unit": "svelte-kit sync && vitest run --config vitest.config.js",
        "test:unit:watch": "vitest --config vitest.config.js",
        "test:all": "npm run test:unit && npm run test:e2e",
        "test:precommit": "npm run test:all",
        "test:e2e:local": "node scripts/run-e2e-local.mjs",
        "supabase:start": "npx supabase start",
        "supabase:stop": "npx supabase stop",
        "supabase:status": "npx supabase status",
        "supabase:env": "node scripts/local-supabase-env.mjs --write",
        "seed:dev": "node scripts/seed-solas-dev.mjs",
        "backup:prod": "node scripts/backup-prod.mjs",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@carbon/charts": "^1.27.18",
        "@carbon/charts-svelte": "^1.22.18",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@smui-extra/autocomplete": "^9.0.2",
        "@smui/button": "^9.0.2",
        "@smui/card": "^9.0.2",
        "@smui/checkbox": "^9.0.2",
        "@smui/common": "^9.0.2",
        "@smui/data-table": "^9.0.2",
        "@smui/dialog": "^9.0.2",
        "@smui/form-field": "^9.0.2",
        "@smui/icon-button": "^9.0.2",
        "@smui/layout-grid": "^9.0.2",
        "@smui/list": "^9.0.2",
        "@smui/select": "^9.0.2",
        "@smui/snackbar": "^9.0.2",
        "@smui/tab": "^9.0.2",
        "@smui/tab-bar": "^9.0.2",
        "@smui/textfield": "^9.0.2",
        "@smui/top-app-bar": "^9.0.2",
        "@supabase/ssr": "^0.12.6",
        "@supabase/supabase-js": "^2.115.0",
        "@sveltejs/adapter-auto": "8.0.0-next.3",
        "@sveltejs/adapter-vercel": "7.0.0-next.8",
        "@sveltejs/kit": "3.0.0-next.25",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tsconfig/svelte": "^5.0.8",
        "@types/luxon": "^3.7.5",
        "@types/node": "^26.4.1",
        "autoprefixer": "^10.5.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "luxon": "^3.7.2",
        "postcss": "^8.5.28",
        "postcss-load-config": "^6.0.1",
        "postcss-preset-env": "^11.5.2",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "smui-theme": "9.0.2",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "svelte-preprocess": "^6.0.5",
        "tslib": "^2.8.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0",
        "yup": "^1.7.1"
    },
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "engines": {
        "node": ">=22.17.0"
    },
    "dependencies": {
        "posthog-js": "^1.427.2"
    }
}
