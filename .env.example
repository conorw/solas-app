# App (local `supabase start` or a remote project)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E2E / seed (CI uses these defaults without GitHub secrets)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=password123
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=password123
TEST_ANONYMOUS_PERSON_ID=2830
# Optional: people list seed size (0 in CI)
SEED_DIRECTORY_COUNT=300
# Optional remote seed targets (project refs only; localhost always allowed). Keep real refs in .env, not the repo.
SEED_ALLOWED_SUPABASE_REFS=
SEED_BLOCKED_SUPABASE_REFS=

# Production dump (npm run backup:prod). Session pooler URI, port 5432 — not 6543.
# In GitHub Actions use PROD_SUPABASE_URL, PROD_SUPABASE_SERVICE_ROLE_KEY, PROD_SUPABASE_DB_URL.
SUPABASE_DB_URL=
